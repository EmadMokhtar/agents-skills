#!/bin/sh
# Refuses a commit message that is not a Conventional Commit.
# Release tools read these messages, so a bad one is refused here and not found in review.
# Turn the hooks on with `just install`.
set -eu

first_line=$(head -n 1 "$1")

case "$first_line" in
    # Git writes these messages itself. An empty message makes git abort the commit.
    "" | "Merge "* | "Revert "* | "fixup! "* | "squash! "*) exit 0 ;;
esac

# The description starts with a lowercase letter and does not end with a period. The pull request
# title check (pr-title.yml) enforces the same rule, so a commit that passes here passes there.
pattern='^(build|bump|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([^)[:space:]]+\))?!?: [a-z].*$'
if printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
    case "$first_line" in
        *.) ;;
        *) exit 0 ;;
    esac
fi

cat >&2 <<'MESSAGE'
The commit message is not a Conventional Commit:

    <type>[scope][!]: <description>

Types: feat, fix, docs, refactor, test, perf, build, ci, chore, style, revert.
Write the description in lowercase, in the imperative mood, with no final period.
Example: fix(auth): reject expired tokens
MESSAGE
exit 1
